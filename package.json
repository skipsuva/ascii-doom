{
  "name": "ascii-doom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-wad": "node scripts/fetch-wad.mjs",
    "predev": "node scripts/fetch-wad.mjs",
    "pretest": "node scripts/fetch-wad.mjs",
    "frame": "vite-node scripts/frame.ts",
    "shoot": "node scripts/shoot.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
